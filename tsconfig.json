{
  "compilerOptions": {
    "target": "es2019",
    "module": "commonjs",
    "jsx": "react",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "composite": true,
    "types": ["node"]
  },
  "include": ["packages/**/*.json"],
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs"
    }
  }
}
