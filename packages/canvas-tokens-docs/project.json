{
  "name": "@workday/canvas-tokens-docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "storybook dev --port 4400 --config-dir packages/canvas-tokens-docs/.storybook"
      },
      "configurations": {
        "ci": {
          "command": "storybook dev --port 4400 --config-dir packages/canvas-tokens-docs/.storybook --quiet"
        }
      }
    },
    "build-storybook": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/docs/storybook/@workday/canvas-tokens-docs"],
      "options": {
        "command": "storybook build --config-dir packages/canvas-tokens-docs/.storybook --output-dir docs/storybook/@workday/canvas-tokens-docs"
      },
      "configurations": {
        "ci": {
          "command": "storybook build --config-dir packages/canvas-tokens-docs/.storybook --output-dir docs/storybook/@workday/canvas-tokens-docs --quiet"
        }
      }
    }
  }
}
