{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "node20",
    "moduleResolution": "node16",
    "types": ["node"],
    "composite": false,
    "noEmit": true
  },
  "include": ["*.ts", "src/**/*.ts"],
  "exclude": ["node_modules"],
  "ts-node": {
    "compilerOptions": {
      "module": "node20"
    }
  }
}
