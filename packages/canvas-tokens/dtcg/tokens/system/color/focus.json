    "$extensions": {
      "sana.canvas.tokens": {
        "modes": {
          "dark": {
            "$value": "{brand.dark.critical.500}"
          }
        }
      }
    }
  },
  "caution-inner": {
    "$value": "{brand.caution.400}",
    "$type": "color",
    "$description": "Tenant-themeable inner focus ring for caution-state elements",
    "$extensions": {
      "sana.canvas.tokens": {
        "modes": {
          "dark": {
            "$value": "{brand.dark.caution.400}"
          }
        }
      }
    }
  },
  "caution-outer": {
    "$value": "{brand.caution.500}",
    "$type": "color",
    "$description": "Tenant-themeable outer focus ring for caution-state elements",
