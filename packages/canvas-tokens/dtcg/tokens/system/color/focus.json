      "sana.canvas.tokens": {
        "modes": {
          "dark": {
            "$value": "{brand.dark.neutral.700}"
          }
        },
        "themes": {
          "brand": {
            "dark": {
              "$value": "{brand.dark.neutral.700}"
            }
          }
        }
      }
    }
  },
  "critical": {
    "$value": "{brand.critical.500}",
