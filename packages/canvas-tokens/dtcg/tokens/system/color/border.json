{
  "default": {
    "$value": "{brand.neutral.A100}",
    "$type": "color",
    "$description": "Default border for containers and dividers",
    "$extensions": {
      "sana.canvas.tokens": {
        "modes": {
          "dark": {
            "$value": "{white.A50}"
          }
        }
      }
    }
  },
  "strong": {
    "$value": "{brand.neutral.A200}",
    "$type": "color",
    "$description": "Stronger border for more visible separation",
    "$extensions": {
      "sana.canvas.tokens": {
        "modes": {
          "dark": {
            "$value": "{white.A100}"
          }
        }
      }
    }
  },
  "input": {
