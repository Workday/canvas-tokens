{
  "motion": {
    "duration": {
      "instant": {
        "$value": "{duration.0}",
        "$type": "duration"
      },
      "short": {
        "$value": "{duration.100}",
        "$type": "duration"
      },
      "medium": {
        "$value": "{duration.250}",
        "$type": "duration"
      },
      "long": {
        "$value": "{duration.400}",
        "$type": "duration"
      },
      "xlong": {
        "$value": "{duration.700}",
        "$type": "duration"
      }
    },
    "easing": {
      "quick": {
        "standard": {
          "$value": "{easing.a-100}",
          "$type": "cubicBezier"
        },
        "acceleration": {
          "$value": "{easing.a-200}",
          "$type": "cubicBezier"
        },
        "deceleration": {
          "$value": "{easing.a-300}",
          "$type": "cubicBezier"
        }
      },
      "purposeful": {
        "standard": {
          "$value": "{easing.b-100}",
          "$type": "cubicBezier"
        },
        "acceleration": {
          "$value": "{easing.b-200}",
          "$type": "cubicBezier"
        },
        "deceleration": {
          "$value": "{easing.b-300}",
          "$type": "cubicBezier"
        }
      }
    }
  }
}
