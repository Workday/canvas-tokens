        }
      },
      "purposeful": {
        "standard": {
          "$value": "{easing.b-100}",
          "$type": "cubicBezier"
        },
        "acceleration": {
          "$value": "{easing.b-200}",
          "$type": "cubicBezier"
        },
        "deceleration": {
          "$value": "{easing.b-300}",
          "$type": "cubicBezier"
        }
      }
    }
